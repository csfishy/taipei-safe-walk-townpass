-- MANUAL LEVEL C PROVISIONING TEMPLATE. Not called by Actions or reset scripts.
-- A captain/security reviewer must first identify a dedicated empty Demo
-- project with no real users/data, install PostGIS in extensions, and record its
-- project reference in the reviewed targets.json allowlist. Never use the
-- existing unclassified project or a production project.
-- Run with an independently verified administrative connection and
-- psql -v project_id=<reviewed-demo-project-ref> -f this-file
-- Set the restricted role password separately through approved secret handling;
-- no password is accepted, embedded, or generated by this SQL template.
\set ON_ERROR_STOP on
\if :{?project_id}
\else
  \echo 'Manual Demo provisioning requires the reviewed project_id variable'
  \quit 3
\endif
SELECT (:'project_id' ~ '^[a-z]{20}$' AND :'project_id' <> 'gxofnhzkqcmzrftxqddi') AS project_ref_valid \gset
\if :project_ref_valid
\else
  \echo 'Refusing invalid or unclassified Supabase project reference'
  \quit 3
\endif

BEGIN;
DO $extension$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_extension e JOIN pg_catalog.pg_namespace n ON n.oid = e.extnamespace
    WHERE e.extname = 'postgis' AND n.nspname = 'extensions'
  ) THEN
    RAISE EXCEPTION 'Manually install PostGIS in extensions before provisioning Demo';
  END IF;
END
$extension$;
DO $role$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'safe_walk_demo_reset') THEN
    CREATE ROLE safe_walk_demo_reset LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
  END IF;
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'safe_walk_demo_reset'
      AND (rolsuper OR rolcreatedb OR rolcreaterole OR rolinherit OR rolbypassrls))
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members
      WHERE member = 'safe_walk_demo_reset'::regrole) THEN
    RAISE EXCEPTION 'Demo reset role privileges are not isolated';
  END IF;
END
$role$;
CREATE SCHEMA IF NOT EXISTS safe_walk_demo AUTHORIZATION safe_walk_demo_reset;
CREATE SCHEMA IF NOT EXISTS safe_walk_demo_control;
CREATE TABLE IF NOT EXISTS safe_walk_demo_control.target (
  singleton boolean PRIMARY KEY DEFAULT true CHECK (singleton),
  environment text NOT NULL CHECK (environment IN ('ci', 'demo')),
  project_id text NOT NULL,
  repository text NOT NULL
);
INSERT INTO safe_walk_demo_control.target (singleton, environment, project_id, repository)
VALUES (true, 'demo', :'project_id', 'csfishy/taipei-safe-walk-townpass')
ON CONFLICT (singleton) DO NOTHING;
SELECT (count(*) = 1 AND bool_and(singleton AND environment = 'demo'
  AND project_id = :'project_id' AND repository = 'csfishy/taipei-safe-walk-townpass')) AS marker_valid
FROM safe_walk_demo_control.target \gset
\if :marker_valid
\else
  \echo 'Existing database marker does not match the reviewed Demo target'
  ROLLBACK;
  \quit 3
\endif
DO $ownership$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_namespace
      WHERE nspname = 'safe_walk_demo' AND nspowner = 'safe_walk_demo_reset'::regrole)
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_namespace
      WHERE nspname = 'safe_walk_demo_control' AND nspowner = 'safe_walk_demo_reset'::regrole) THEN
    RAISE EXCEPTION 'Demo schema or read-only control ownership is invalid';
  END IF;
END
$ownership$;
REVOKE ALL ON SCHEMA safe_walk_demo FROM PUBLIC;
REVOKE ALL ON SCHEMA safe_walk_demo_control FROM PUBLIC;
REVOKE ALL ON safe_walk_demo_control.target FROM PUBLIC, safe_walk_demo_reset;
GRANT USAGE ON SCHEMA safe_walk_demo_control, extensions TO safe_walk_demo_reset;
GRANT SELECT ON safe_walk_demo_control.target TO safe_walk_demo_reset;
COMMIT;
